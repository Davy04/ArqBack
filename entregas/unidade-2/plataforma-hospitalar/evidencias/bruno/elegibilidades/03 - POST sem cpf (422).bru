meta {
  name: 03 - POST sem cpf (422)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/elegibilidades
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "codigo_operadora": "OPS-001",
    "matricula_plano": "MAT-2026-001"
  }
}

assert {
  res.status: eq 422
  res.body.codigo: eq dados_invalidos
}

docs {
  O campo cpf foi removido do corpo. Responde 422 com codigo "dados_invalidos" e
  um detalhe apontando o campo "body.cpf". O erro faz parte do contrato.
}
